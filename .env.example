APP_NAME=Laravel
# Production: APP_ENV=production, APP_DEBUG=false
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production so cookies are only sent over HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------- Security ----------
# API rate limits (requests per minute)
API_RATE_LIMIT=120
PUBLIC_API_RATE_LIMIT=60
# Sanctum bearer token lifetime in minutes (default 1440 = 24 hours)
SANCTUM_TOKEN_EXPIRATION=1440
# Comma-separated list of allowed cross-origin domains (leave empty for same-origin only)
CORS_ALLOWED_ORIGINS=
# Secret for the /cron/tick HTTP endpoint (hosts without CLI cron); leave empty to disable
CRON_SECRET=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_QUEUE_ASYNC=false

# WhatsApp driver: meta (Cloud API) au africas_talking (chat API)
WHATSAPP_DRIVER=africas_talking
AT_WHATSAPP_USERNAME=
AT_WHATSAPP_API_KEY=
AT_WHATSAPP_WA_NUMBER=
AT_WHATSAPP_BASE_URL=https://chat.africastalking.com/whatsapp/message/send

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_TEMPERATURE=0.3

VITE_APP_NAME="${APP_NAME}"

# Africa's Talking (SMS za kawaida)
SMS_DRIVER=africas_talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENV=sandbox
