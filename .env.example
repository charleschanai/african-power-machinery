APP_NAME=Laravel
# Production: APP_ENV=production, APP_DEBUG=false
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# info, not debug: debug-level logs retain guest names, phone numbers and
# stack traces in storage/logs.
LOG_LEVEL=info
# Retention per channel, in days.
LOG_DAILY_DAYS=14
LOG_ERROR_DAYS=30
LOG_SQL_DAYS=14
LOG_PERFORMANCE_DAYS=7
LOG_SECURITY_DAYS=60
LOG_EXTERNAL_DAYS=14
LOG_MONITORING_DAYS=30
# Set the sql channel to debug to include query bindings in sql.log. Off by
# default because bindings contain personal data.
LOG_SQL_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecard_system
DB_USERNAME=root
DB_PASSWORD=
# The jobs and failed_jobs tables can live on a separate connection.
# DB_QUEUE_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production so cookies are only sent over HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

# ---------- Security ----------
# API rate limits (requests per minute)
API_RATE_LIMIT=120
PUBLIC_API_RATE_LIMIT=60
# Failed logins before the account is locked out for LOGIN_DECAY_MINUTES.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=5
# Two-factor code attempts, applied to every 2FA endpoint.
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_DECAY_MINUTES=5
# Sanctum bearer token lifetime in minutes (default 1440 = 24 hours)
SANCTUM_TOKEN_EXPIRATION=1440
# Comma-separated list of allowed cross-origin domains (leave empty for same-origin only)
CORS_ALLOWED_ORIGINS=
# Secret for the /cron/tick HTTP endpoint (hosts without CLI cron); leave empty to disable
CRON_SECRET=

# Reverse proxies. TLS is normally terminated upstream, so without this
# $request->isSecure() is false, the HTTPS redirect loops, HSTS is never sent,
# and Meta's webhook POST gets a 302 that discards the request body.
# Narrow TRUSTED_PROXIES to your load balancer's CIDR where you can: trusting
# every proxy also trusts client-supplied X-Forwarded-For, and the login
# rate limiter is keyed on the client IP.
TRUSTED_PROXIES=*
# Comma-separated hostnames to accept in the Host header.
TRUSTED_HOSTS=

# ---------- Monitoring ----------
# Master switch. Set to false to disable all metrics, the slow-query listener
# and request timing at once — useful when profiling a slow request.
MONITORING_ENABLED=true
# Keep individual metrics in the system_metrics table. Aggregate counters
# always go to the cache regardless of this setting.
MONITORING_PERSIST=true
# Thresholds
MONITORING_SLOW_REQUEST_MS=1000
MONITORING_SLOW_QUERY_MS=250
# A request running more than this many queries is flagged as a likely N+1.
MONITORING_QUERY_BUDGET=60
# Health check thresholds. One per reported check: database, queue, disk,
# performance, scheduler and providers.
MONITORING_DB_CONNECT_MS=500
MONITORING_DB_SLOW_RATIO=0.1
MONITORING_DB_SIZE_MB=2048
MONITORING_ERROR_RATE=0.05
MONITORING_QUEUE_BACKLOG=100
MONITORING_DISK_FREE_MB=500
MONITORING_PROVIDER_TIMEOUT_MS=10000
# Alert delivery. Without a number here, alerts are logged but not sent.
MONITORING_ALERTS=true
MONITORING_ALERT_CHANNEL=whatsapp
MONITORING_ALERT_TO=
# Minimum minutes between two alerts that share a key, so one outage does
# not produce hundreds of messages.
MONITORING_ALERT_THROTTLE=30
# Retention, in days. Entry logs are kept forever by default: they are the
# core record of who entered the venue, and losing them is worse than a full
# disk. The health check warns before that becomes a problem.
MONITORING_METRICS_DAYS=30
MONITORING_AUDIT_DAYS=180
MONITORING_ENTRY_LOGS_DAYS=0
MONITORING_WA_MESSAGES_DAYS=365

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_QUEUE_ASYNC=false

# WhatsApp driver: meta (Cloud API) au africas_talking (chat API)
WHATSAPP_DRIVER=africas_talking
AT_WHATSAPP_USERNAME=
AT_WHATSAPP_API_KEY=
AT_WHATSAPP_WA_NUMBER=
AT_WHATSAPP_BASE_URL=https://chat.africastalking.com/whatsapp/message/send

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_TEMPERATURE=0.3

# ---------- SMS (NextSMS) ----------
# SmsService reads exactly these four keys. If they are empty, isConfigured()
# returns false and every send fails silently with "The SMS API is not
# configured" — no exception, no log entry, just failures in the admin UI.
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=

# ---------- Queue ----------
# The worker MUST listen on all of these. Jobs go to named queues:
#   InvitationCampaignService -> onQueue('whatsapp') / onQueue('sms')
#   ProcessScheduledSms      -> onQueue('sms')
# A worker without --queue listens on 'default' only and those jobs never run.
#   php artisan queue:work --queue=default,whatsapp,sms
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
